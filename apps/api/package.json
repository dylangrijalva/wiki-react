{
  "name": "@rendered/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --external:hono --external:@hono/node-server --external:@libsql/client --external:drizzle-orm --external:zod --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run test"
  },
  "dependencies": {
    "@hono/node-server": "2.1.9",
    "@libsql/client": "0.18.0",
    "@rendered/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
