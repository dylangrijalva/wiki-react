{
  "name": "react-rendered",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @rendered/api --filter @rendered/web dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @rendered/api start",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "typescript-eslint": "^8.50.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "@playwright/test": "^1.58.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.16",
    "@types/node": "^24.10.0"
  }
}
